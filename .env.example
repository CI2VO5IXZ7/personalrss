# PersonalRSS Generator (Instagram / Stock → RSS) 配置模板
# 公开 RSS 路径为 /feeds/<id>.xml

# Optional: use these only if you want API Token auth for deploy scripts.
# Leave them empty to use browser auth via `npx wrangler login`.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Worker vars
BASE_URL=https://your-worker.workers.dev
CACHE_MAX_POSTS=100
REFRESH_CONCURRENCY=3
