# PersonalRSS 三总成 (Generator / Monitor / Push) 配置模板
# 公开 RSS 路径为 /feeds/<id>.xml
# 旧路径/命令 (如 /rss/ig, /add_ig, /rss_*, /stock_*, /refresh_ig, /purge_ig) 已被删除。

# Optional: use these only if you want API Token auth for deploy scripts.
# Leave them empty to use browser auth via `npx wrangler login`.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Worker vars
BASE_URL=https://your-worker.workers.dev
CACHE_TTL_MINUTES=60
CACHE_MAX_POSTS=100
REFRESH_CONCURRENCY=3
FAILURE_ALERT_THRESHOLD=3

# 7 Runtime Secrets (可通过 GitHub Actions Secrets 配置)
# 1. TELEGRAM_BOT_TOKEN - 管理机器人 Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# 2. TELEGRAM_CHAT_ID - 接收告警消息的 Chat ID
TELEGRAM_CHAT_ID=your_telegram_chat_id
# 3. TELEGRAM_ADMIN_USER_ID - 允许操作管理命令的个人 Telegram User ID
TELEGRAM_ADMIN_USER_ID=your_telegram_admin_user_id
# 4. ADMIN_TOKEN - 管理接口认证 Token，用于 SHA256 派生 Webhook Secret
ADMIN_TOKEN=your_random_admin_token
# 5. DEEPSEEK_API_KEY - DeepSeek 摘要 API 密钥
DEEPSEEK_API_KEY=your_deepseek_api_key
# 6. PUSH_TELEGRAM_BOT_TOKEN - Push 订阅推送机器人 Token
PUSH_TELEGRAM_BOT_TOKEN=your_push_telegram_bot_token
# 7. PUSH_TELEGRAM_CHANNEL_ID - Push 订阅推送目标频道 ID (首次推送最新 1 篇)
PUSH_TELEGRAM_CHANNEL_ID=your_private_channel_id
