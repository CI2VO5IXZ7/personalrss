# Optional: use these only if you want API Token auth for deploy scripts.
# Leave them empty to use browser auth via `npx wrangler login`.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Worker vars
BASE_URL=https://your-worker.workers.dev
CACHE_TTL_MINUTES=60
CACHE_MAX_POSTS=100
REFRESH_CONCURRENCY=3
FAILURE_ALERT_THRESHOLD=3

# Worker secrets
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# Required: private Telegram user allowed to run management commands.
TELEGRAM_ADMIN_USER_ID=your_telegram_admin_user_id
ADMIN_TOKEN=your_random_admin_token
DEEPSEEK_API_KEY=your_deepseek_api_key
PUSH_TELEGRAM_BOT_TOKEN=your_push_telegram_bot_token
PUSH_TELEGRAM_CHANNEL_ID=your_private_channel_id
